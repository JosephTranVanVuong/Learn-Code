# Copy file này thành ".env" ở thư mục gốc (cùng cấp với docker-compose.lan.yml)
# trên MÁY-SERVER luôn bật. docker-compose tự đọc file ".env" ở đây.

# IP tĩnh (hoặc DHCP reservation) của MÁY-SERVER trong mạng LAN công ty.
LAN_HOST=192.168.1.50

# Sinh ngẫu nhiên, KHÔNG dùng lại giá trị mẫu:
#   openssl rand -hex 32   (hoặc: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=
COOKIE_SECRET=
