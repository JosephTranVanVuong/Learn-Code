# Copy file này thành ".env" ở thư mục gốc (cùng cấp với docker-compose.yml).
# docker-compose tự động đọc file ".env" ở đây để thay thế các biến ${...}
# trong docker-compose.yml — KHÁC với apps/api/.env dùng khi chạy "pnpm dev".

# Tên miền công khai (không có https://, không có dấu / cuối).
# Nếu chưa có domain riêng: dùng nip.io trỏ vào IP VPS, vd IP 203.0.113.10
# -> PUBLIC_DOMAIN=thuvien.203.0.113.10.nip.io
PUBLIC_DOMAIN=doi-ten-mien-cua-ban.example.com

# Sinh ngẫu nhiên, KHÔNG dùng lại giá trị mẫu:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
COOKIE_SECRET=

# Tuỳ chọn — chỉ cần nếu dùng chức năng gửi email thông báo quá hạn
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Thư viện ĐCV Phaolô Lê Bảo Tịnh <no-reply@thuvien.local>
