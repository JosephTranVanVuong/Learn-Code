{
  "name": "thuvien-cvpl",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @thuvien/database db:generate",
    "db:migrate": "pnpm --filter @thuvien/database db:migrate",
    "db:seed": "pnpm --filter @thuvien/database db:seed",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.10.0"
}
